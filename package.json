{
  "name": "xuepoo-blog",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --outfile static/js/blog-renderer.js --minify",
    "dev": "bun build src/index.ts --outfile static/js/blog-renderer.js --watch --minify",
    "obfuscate": "bun scripts/obfuscate.ts",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint": "oxlint --deny-warnings src",
    "lint:biome": "biome lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@vectojs/core": "^1.24.0",
    "@vectojs/markdown": "^0.5.0",
    "@vectojs/ui": "^2.5.0",
    "katex": "^0.17.0",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "@types/katex": "^0.16.8",
    "@types/marked": "^6.0.0",
    "carryctx": "0.4.4",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2"
  }
}
